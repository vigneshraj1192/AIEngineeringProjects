# LLM Provider Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
CODEPILOT_MODEL_NAME=gemini-3.8-flash

# Optional: LangSmith Tracing & Observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=codepilot-devstream
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional: Live GitHub Access (Omit or leave blank for local/demo mock provider)
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_REPOSITORY=devstream-labs/sample-repo

# CodePilot Settings
CODEPILOT_DEMO_MODE=true
CODEPILOT_POLL_INTERVAL=300
CODEPILOT_TOKEN_BUDGET=4000
CODEPILOT_COMPLEXITY_THRESHOLD=7
CODEPILOT_RETRIEVAL_STRATEGY=keyword
